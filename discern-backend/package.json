{
  "name": "@discern/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Discern API and worker",
  "main": "dist/index.js",
  "scripts": {
    "atlas:index": "tsx src/scripts/create-search-indexes.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "embed": "tsx src/scripts/embed-corpus.ts",
    "eval": "tsx src/scripts/eval-abigail.ts",
    "compare": "tsx src/scripts/compare-retrieval.ts",
    "enrich": "tsx src/scripts/enrich-corpus.ts",
    "ingest": "tsx src/scripts/ingest-bible.ts",
    "query": "tsx src/scripts/query-corpus.ts",
    "reclassify:handling": "tsx src/scripts/reclassify-handling.ts",
    "audit:stages": "tsx src/scripts/audit-stage-anchors.ts",
    "seed": "tsx src/scripts/seed-corpus.ts",
    "seed:stages": "tsx src/scripts/seed-stages.ts",
    "segment": "tsx src/scripts/segment-passages.ts",
    "dev:worker": "SERVICE_NAME=discern-worker tsx watch src/worker/index.ts",
    "lint": "eslint .",
    "prebuild": "npm --prefix ../shared run build",
    "start": "node dist/index.js",
    "start:worker": "SERVICE_NAME=discern-worker node dist/worker/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "premise:dist": "tsx src/scripts/premise-distribution.ts",
    "eval:critical": "tsx src/scripts/eval-critical.ts",
    "testers": "tsx src/scripts/make-testers.ts",
    "transcripts": "tsx src/scripts/read-transcripts.ts",
    "latency": "tsx src/scripts/latency-breakdown.ts"
  },
  "dependencies": {
    "@discern/shared": "0.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "openai": "^6.49.0",
    "pino": "^9.6.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "vitest": "^3.1.2"
  }
}
