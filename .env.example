# Discern — canonical environment inventory.
#
# This root file is the COMPLETE inventory. Every process.env key read anywhere
# in the codebase must appear here with a placeholder and a one-line comment.
# Backend loaders call dotenv.config() for the CWD first, then backfill from
# this repo-root .env (CONVENTIONS.md §2).
#
# Keys are added in the phase that first reads them. Phase 0 is scaffold only,
# so NOTHING here is read by code yet — the inventory is declared up front so it
# never lags behind the design in ARCHITECTURE.md.

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development                    # development | test | production
PORT=8080                               # HTTP port for the API web service
LOG_LEVEL=info                          # fatal | error | warn | info | debug | trace | silent

# Which process this is, for the logger's `service` base field. Set by the
# start:worker / dev:worker npm scripts; you do not normally set it by hand.
# On Render, RENDER_SERVICE_NAME is injected automatically and takes precedence.
SERVICE_NAME=

# Injected by Render, never set by hand. Listed because the code READS them and
# this file is the complete inventory. RENDER_GIT_COMMIT is what /healthz reports
# as `commit`, so "is this running what I just pushed" is one curl.
#   RENDER_GIT_COMMIT
#   RENDER_SERVICE_NAME

# ---- Database ---------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/discern  # Mongo connection string. Atlas in prod
                                               # (Atlas Vector Search requires Atlas).
                                               # MUST include the /discern database path: a URI
                                               # with no path silently connects to `test`, and one
                                               # copied from a neighbour lands in THEIR database.
                                               # Boot refuses if the resolved name is wrong.
MONGODB_DB_NAME=discern                 # Database Discern asserts it is connected to at boot.
MONGODB_MAX_POOL_SIZE=10                # Sockets per process. Low on purpose: shared cluster.

# ---- Auth — REQUIRED FROM PHASE 4 (now) -------------------------------------
# Phase 4 issues tokens, so this is load-bearing and required at boot.
#
# Needs 32 BYTES of key material (not 32 characters). Both of these work:
#   openssl rand -hex 32      -> 64 hex chars
#   openssl rand -base64 32   -> 44 base64 chars
# Note `openssl rand -base64 64` WRAPS onto two lines; paste one line or use -hex 32.
# Do not use Render's dashboard "Generate" button.
JWT_SECRET=
JWT_EXPIRES_IN=30d                      # Token lifetime.

# ---- AI providers (Phase 3 embeddings, Phase 6 reasoning) -------------------
# REQUIRED AT BOOT, always. Embeddings are the first thing that touches a
# provider (Phase 3) and everything after depends on them.
OPENAI_API_KEY=                         # Reasoning, premise pass, safety classifier, embeddings.

# Model IDs are CONFIG, not constants (CONVENTIONS.md §2, ARCHITECTURE.md §7).
# These are the env overrides for src/config/models.ts, which owns the defaults.
# Left blank = the default in that file. Setting one swaps a model with no code
# change and no redeploy. Tiers exist because running the reasoning model on
# every turn is the largest avoidable cost in the app.
SAFETY_MODEL=                           # Cheapest/fastest. Runs on EVERY turn before anything else.
PREMISE_MODEL=                          # Mid. The premise pass — the product's whole differentiator.
CONVERSATION_MODEL=                     # Cheap. Acknowledgments and small follow-ups.
REASONING_MODEL=                        # Expensive. ONLY for turns that surface a passage,
                                        # name a stage, or correct a premise.
EMBEDDING_MODEL=                        # Corpus + query embeddings. CHANGING THIS INVALIDATES THE
                                        # INDEX — embeddingModel is recorded per document so the
                                        # backfill can detect it and re-run. A query embedded with a
                                        # different model than the corpus does not error, it just
                                        # retrieves badly.

# ---- Voice — REQUIRED FROM PHASE 7 (the only real variable cost in the app) --
# Optional until then, but VALIDATED WHENEVER PRESENT and asserted by
# services/speech on first use. Leave blank rather than inventing a placeholder:
# a placeholder that satisfies a boot check is how a real key never gets set.
ELEVENLABS_API_KEY=                     # TTS. Billed per character; keep out of test runs.
ELEVENLABS_VOICE_ID=                    # Abigail's voice. Config, not a constant.

# ---- Object storage: S3 — REQUIRED FROM PHASE 7 -----------------------------
# Mongo stores the S3 key only, never the blob (ARCHITECTURE.md §4).
# Optional until Phase 7; asserted by services/speech on first upload.
AWS_REGION=us-east-1                    # A REAL AWS region. "auto" is an R2-ism the SDK rejects,
                                        # and it is rejected here at config time instead.
AWS_ACCESS_KEY_ID=                      # Scoped IAM user for discern-audio ONLY. Server-only.
AWS_SECRET_ACCESS_KEY=                  # Server-only. Never EXPO_PUBLIC_.
S3_BUCKET=discern-audio                 # Bucket holding TTS output and cached narration.
                                        # Checked against S3 bucket naming rules when set.

# ---- RevenueCat — REQUIRED FROM PHASE 4 (now) -------------------------------
# Required at boot. The webhook fails closed without it (503), because a service
# that silently accepts unverified billing callbacks is worse than one that will
# not start. NOT strength-validated: the value is issued by RevenueCat, so its
# format is theirs to choose and a floor here could reject a legitimate secret.
REVENUECAT_WEBHOOK_SECRET=              # Shared secret, timing-safe compared. Fail-closed in prod.
REVENUECAT_SECRET_API_KEY=              # Server key for evidence-gated subscriber reads.

# ---- Entitlement ------------------------------------------------------------
# NO FREE TIER (ARCHITECTURE.md §10 decision 3, corrected 2026-09-01). A 7-day
# trial on the ANNUAL sku only, then a hard paywall. There is nothing to tune
# here: entitlement is the only gate, so there is no allowance config.

# ---- Journey ----------------------------------------------------------------
ACTIVE_CARRYING_CAP=3                   # Soft cap on active carryings. A PRODUCT rule, not a
                                        # technical one: you cannot dwell on ten things, and an
                                        # unbounded list makes this a reading queue. Adding past
                                        # the cap prompts a release; nothing is auto-evicted.

# ---- Prompts (NOT in the repository) -----------------------------------------
PROMPTS_DIR=                            # Directory holding abigail-system.txt and
                                        # premise-system.txt. LEAVE EMPTY normally: the
                                        # loader then checks ./prompts and ../prompts, which
                                        # covers running from the repo root and from
                                        # discern-backend/. Set it only when the files are
                                        # mounted elsewhere. The service REFUSES TO BOOT
                                        # without them — see config/prompts.ts.

# ---- Throwaway test client (delete before launch) ---------------------------
TEST_CLIENT_ENABLED=false               # Serves the plain HTML test page at GET /test. DEFAULT OFF.
                                        # Turn it ON only where testers need to reach it — a link to
                                        # localhost is useless on someone else's phone. Same origin
                                        # as the API, so there is no CORS to configure. Delete this
                                        # flag, the route in app.ts, and public/abigail-test.html
                                        # when testing ends.

# ---- Worker tuning (Phase 8) ------------------------------------------------
WORKER_POLL_INTERVAL_MS=2000            # Idle poll interval for the Mongo-backed queue.
WORKER_LEASE_SECONDS=300                # Job lease. Expired leases are reaped and retried.
WORKER_CONCURRENCY=2                    # Jobs in flight per worker process.

# ---- Frontend (Expo public keys — Phase 9, prefixed EXPO_PUBLIC_) -----------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080  # Backend origin the app talks to.
